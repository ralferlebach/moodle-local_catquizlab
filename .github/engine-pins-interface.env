# Interface E2E candidate engine pins for CatQuizLab 0.7.42 / local_catquiz #146.
#
# Deliberately separate from the proven release/worker pins in engine-pins.env.
# ui-e2e.yml passes PINS_FILE to fetch-engine.sh, so its mandatory Playwright
# run exercises the new CatQuiz + adaptivequiz host commits as a coordinated
# *candidate* set without silently declaring the release/worker stack migrated.
# The full engine manifest is uploaded by ui-e2e.yml.
#
# Promote into engine-pins.env only after CatQuizLab #136 is accepted:
# - local_catquiz #146 and #147; cold/warm/parallel and upgrade tests;
# - 512 MiB CLASSIC/ALLSUBS and actual Worker/Release gates;
# - coherent 4.5 and 5.2 CAT-model/host combinations.
#
# Legacy Moodle 4.5 (2026-10-17). Catmodel has no newer candidate in this change.
LEGACY_CATQUIZ_REF=ALiSe-v-1.2.0-legacy
LEGACY_CATQUIZ_SHA=8a62ce30db1fa66fb1712e7079dc4caaf5003f20
LEGACY_ADAPTIVEQUIZ_REF=ALiSe-v-1.2.0-legacy
LEGACY_ADAPTIVEQUIZ_SHA=50b7aad7a783003bff30a57e21854120fee0f32d
LEGACY_CATMODEL_REF=ALiSe-v-1.2.0-legacy
LEGACY_CATMODEL_SHA=1414a9cc8e0f436f19f4647348217196c9692c95

# Moodle 5.2 candidate set (the interface runner is 4.5-only as of this commit;
# this M5 entry is explicit provenance for the upcoming 5.x interface matrix).
M5_CATQUIZ_REF=migration-zu-moodle-5.x
M5_CATQUIZ_SHA=02c856f092d91f2387b8499c7c02f8948fb909cc
M5_ADAPTIVEQUIZ_REF=v-3.0
