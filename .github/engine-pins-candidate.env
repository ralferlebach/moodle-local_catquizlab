# The candidate engine set: the branch heads at the moment of the run, NOT pinned (#136; 20.11.2026).
#
# Every job that plays "candidate" takes the heads of the branches below as it finds them and writes the commits it
# got into its engine manifest — so a red candidate job names the engine state that broke the lab, the same day it was
# pushed, without the release gate (engine-pins.env) moving with it. Same branches as the release set.
#
# Until 0.7.72 this was engine-pins-interface.env, a second pinned set (CatQuiz #146, 17.10.2026) that had fallen a
# month behind the branches; the release set has since caught up with it and beyond.
LEGACY_CATQUIZ_REF=ALiSe-v-1.2.0-legacy
LEGACY_ADAPTIVEQUIZ_REF=ALiSe-v-1.2.0-legacy
LEGACY_CATMODEL_REF=ALiSe-v-1.2.0-legacy
M5_CATQUIZ_REF=migration-zu-moodle-5.x
M5_ADAPTIVEQUIZ_REF=v-3.0
M5_CATMODEL_REF=v-3.0
WUNDERBYTE_TABLE_REF=main
ENGINE_FOLLOW_HEADS=1
