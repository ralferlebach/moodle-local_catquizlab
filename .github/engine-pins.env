# The engine set every CI job tests against: branch AND commit (re-audit 16.10.2026, AK 5).
#
# Read by .github/scripts/fetch-engine.sh, which every job that installs the
# engine uses — PHPUnit, Behat, the interface and the worker end-to-end runs.
# The branch says which line, the commit which state of it; the commit is what
# makes two runs comparable. A job writes the commits it actually tested into
# its engine manifest (artifact "engine-manifest-…").
#
# To move the set forward: check the new heads against catquizlab (the engine's
# CHANGELOG, its status codes, its progress format, its validity reasons), then
# replace the SHAs here in one commit. ENGINE_FOLLOW_HEADS=1 tests the branch
# heads instead, for that check.
#
# Verified 16.10.2026 against local_catquizlab 0.7.41.

# Moodle 4.5: local_catquiz 1.2.1 and its host, ALiSe-v-1.2.0-legacy.
LEGACY_CATQUIZ_REF=ALiSe-v-1.2.0-legacy
LEGACY_CATQUIZ_SHA=ee1f096f72efe9bb619cf82729c47a2abd155fcc
LEGACY_ADAPTIVEQUIZ_REF=ALiSe-v-1.2.0-legacy
LEGACY_ADAPTIVEQUIZ_SHA=d128621d3dfc82712b4a91fd4be21debcf2e0f9e
LEGACY_CATMODEL_REF=ALiSe-v-1.2.0-legacy
LEGACY_CATMODEL_SHA=1414a9cc8e0f436f19f4647348217196c9692c95

# Moodle 5.1 and up: local_catquiz 1.3.0 and the v-3.0 host.
M5_CATQUIZ_REF=migration-zu-moodle-5.x
M5_CATQUIZ_SHA=0f6983225a595a22f74623bc0c103ca960122efa
M5_ADAPTIVEQUIZ_REF=v-3.0
M5_ADAPTIVEQUIZ_SHA=df4d69e598e96b0dc6407c603a57fd624798db6b
M5_CATMODEL_REF=v-3.0
M5_CATMODEL_SHA=e724f6acdb56b05dafc0beb1e955b0277b05f497

# The table library the engine needs, for both sets.
WUNDERBYTE_TABLE_REF=main
