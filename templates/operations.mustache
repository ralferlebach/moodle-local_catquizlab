{{!
    @template local_catquizlab/operations

    Operations view: health, workers, queue and recovery actions.

    Every action here replaces a shell command that used to be the only way to
    do it. The health list leads each failed check to the page that fixes it,
    because a check that only reports a problem leaves the work undone.

    Context variables required for this template:
    * health - status, checks with label/detail/status flags
    * workers - hasany, rows
    * queue - queued, running, collected, failed
    * stuck - hasany, rows
    * inflight - hasany, rows
    * sesskey, actionurl, cantoken

    Example context (json):
    {
        "health": {"status": "ok", "checks": [], "blockers": 0, "warnings": 0},
        "workers": {"hasany": false, "rows": []},
        "queue": {"queued": 0, "running": 0, "collected": 0, "failed": 0},
        "stuck": {"hasany": false, "rows": []},
        "inflight": {"hasany": false, "rows": []},
        "sesskey": "abc123",
        "actionurl": "/local/catquizlab/operations.php",
        "cantoken": false
    }
}}
<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}wizard:heading, local_catquizlab{{/str}}</h3>
        {{#wizard.stages}}
            <div class="mb-2">
                <strong>
                    <span class="badge {{#ok}}badge-success{{/ok}}{{#incomplete}}badge-secondary{{/incomplete}}">
                        {{#ok}}OK{{/ok}}{{#incomplete}}&hellip;{{/incomplete}}
                    </span>
                    {{label}}
                </strong>
                <ul class="list-unstyled ml-4 mb-0 small">
                    {{#steps}}
                        <li>
                            {{#ok}}&check;{{/ok}}{{#missing}}&times;{{/missing}} {{label}}
                            {{#detail}}<span class="text-muted">— {{detail}}</span>{{/detail}}
                        </li>
                    {{/steps}}
                </ul>
                {{#incomplete}}{{#hint}}<p class="small text-muted ml-4 mb-0">{{hint}}</p>{{/hint}}{{/incomplete}}
            </div>
        {{/wizard.stages}}

        {{#wizard.ready}}
            <div class="alert alert-success mb-2" role="status">
                {{#str}}wizard:ready, local_catquizlab{{/str}}
            </div>
        {{/wizard.ready}}

        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="wizard">
            <button type="submit" class="btn btn-secondary">{{#str}}wizard:run, local_catquizlab{{/str}}</button>
        </form>
        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="wizardstart">
            <button type="submit" class="btn btn-primary">{{#str}}wizard:runandenable, local_catquizlab{{/str}}</button>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}runtime:heading, local_catquizlab{{/str}}</h3>
        <ul class="list-unstyled mb-2">
            {{#runtime.steps}}
                <li>
                    <span class="badge {{#ok}}badge-success{{/ok}}{{#missing}}badge-danger{{/missing}}">
                        {{#ok}}OK{{/ok}}{{#missing}}&times;{{/missing}}
                    </span>
                    {{label}} <span class="text-muted small">{{detail}}</span>
                </li>
            {{/runtime.steps}}
        </ul>
        {{#canruntime}}
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="setupruntime">
                <button type="submit" class="btn btn-primary">{{#str}}runtime:setup, local_catquizlab{{/str}}</button>
            </form>
        {{/canruntime}}
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}ops:system, local_catquizlab{{/str}}</h3>
        <ul class="list-unstyled mb-0">
            {{#health.checks}}
                <li class="mb-1">
                    <span class="badge {{#ok}}badge-success{{/ok}}{{#warn}}badge-warning{{/warn}}{{#fail}}badge-danger{{/fail}}">
                        {{#ok}}OK{{/ok}}{{#warn}}!{{/warn}}{{#fail}}&times;{{/fail}}
                    </span>
                    <strong>{{label}}</strong>
                    <span class="text-muted">{{detail}}</span>
                    {{#actionurl}}<a href="{{actionurl}}">{{#str}}settings, core{{/str}}</a>{{/actionurl}}
                </li>
            {{/health.checks}}
        </ul>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}access:heading, local_catquizlab{{/str}}</h3>
        <ul class="list-unstyled mb-2">
            {{#access.steps}}
                <li>
                    <span class="badge {{#ok}}badge-success{{/ok}}{{#missing}}badge-danger{{/missing}}">
                        {{#ok}}OK{{/ok}}{{#missing}}&times;{{/missing}}
                    </span>
                    {{label}}
                </li>
            {{/access.steps}}
        </ul>
        {{#cansetup}}
            <p class="text-muted small">{{#str}}access:explain, local_catquizlab{{/str}}</p>
            <form method="post" action="{{actionurl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="setupaccess">
                <button type="submit" class="btn btn-primary">{{#str}}access:setup, local_catquizlab{{/str}}</button>
            </form>
        {{/cansetup}}
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}ops:workers, local_catquizlab{{/str}}</h3>
        {{#workers.hasany}}
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th scope="col">{{#str}}ops:worker, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}ops:slot, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}ops:jobsdone, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}ops:heartbeat, local_catquizlab{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#workers.rows}}
                        <tr>
                            <td>{{workerid}}</td>
                            <td>{{slot}}</td>
                            <td>{{jobsdone}}</td>
                            <td>{{heartbeat}}</td>
                        </tr>
                    {{/workers.rows}}
                </tbody>
            </table>
        {{/workers.hasany}}
        {{^workers.hasany}}
            <p class="text-muted">{{#str}}health:workersnone, local_catquizlab{{/str}}</p>
        {{/workers.hasany}}

        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="startworkers">
            <button type="submit" class="btn btn-primary">{{#str}}ops:startworkers, local_catquizlab{{/str}}</button>
        </form>
        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="reap">
            <button type="submit" class="btn btn-secondary">{{#str}}ops:reap, local_catquizlab{{/str}}</button>
        </form>
        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="selftest">
            <button type="submit" class="btn btn-secondary">{{#str}}ops:selftest, local_catquizlab{{/str}}</button>
        </form>
        <form method="post" action="{{actionurl}}" class="d-inline">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="installbrowser">
            <button type="submit" class="btn btn-secondary">{{#str}}ops:installbrowser, local_catquizlab{{/str}}</button>
        </form>

        {{#selftest}}
            <div class="alert {{#ok}}alert-success{{/ok}}{{^ok}}alert-danger{{/ok}} mt-3" role="status">
                <strong>{{#str}}ops:selftestresult, local_catquizlab{{/str}}</strong>
                <pre class="mb-0 small">{{output}}</pre>
            </div>
        {{/selftest}}
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}ops:queue, local_catquizlab{{/str}}</h3>
        <p>{{#str}}worker:queue, local_catquizlab{{/str}}
            {{queue.queued}} / {{queue.running}} / {{queue.collected}} / {{queue.failed}}</p>

        <h4 class="h6">{{#str}}ops:stuckattempts, local_catquizlab{{/str}}</h4>
        {{#stuck.hasany}}
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th scope="col">{{#str}}ops:attempt, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}ops:worker, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}worker:tries, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}ops:heartbeat, local_catquizlab{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#stuck.rows}}
                        <tr>
                            <td>#{{attemptid}} (run {{runid}})</td>
                            <td>{{owner}}</td>
                            <td>{{tries}}</td>
                            <td>{{since}}</td>
                        </tr>
                        {{#lasterror}}<tr><td colspan="4" class="small text-muted">{{lasterror}}</td></tr>{{/lasterror}}
                    {{/stuck.rows}}
                </tbody>
            </table>
        {{/stuck.hasany}}
        {{^stuck.hasany}}
            <p class="text-muted">{{#str}}ops:nostuck, local_catquizlab{{/str}}</p>
        {{/stuck.hasany}}

        {{#empty}}
            <div class="alert alert-warning" role="status">
                <strong>{{#str}}ops:emptyheading, local_catquizlab{{/str}}</strong>
                <p class="mb-1">{{#str}}ops:emptyexplain, local_catquizlab{{/str}}</p>
                <ul class="small mb-2">
                    {{#rows}}<li>#{{attemptid}} (run {{runid}}, {{twinid}}) &mdash; {{since}}</li>{{/rows}}
                </ul>
                <form method="post" action="{{actionurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="purgeempty">
                    <button type="submit" class="btn btn-sm btn-secondary">
                        {{#str}}ops:purgeempty, local_catquizlab{{/str}}
                    </button>
                </form>
            </div>
        {{/empty}}

        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="releaseorphans">
            <button type="submit" class="btn btn-secondary">{{#str}}ops:releaseorphans, local_catquizlab{{/str}}</button>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}ops:runs, local_catquizlab{{/str}}</h3>
        {{#inflight.hasany}}
            <table class="table table-sm">
                <tbody>
                    {{#inflight.rows}}
                        <tr>
                            <td>#{{runid}} {{cellkey}}</td>
                            <td>{{status}}</td>
                            <td>{{collected}}/{{total}}</td>
                            <td>
                                <a href="{{pauseurl}}" class="btn btn-sm btn-outline-secondary">
                                    {{#paused}}{{#str}}ops:resumerun, local_catquizlab{{/str}}{{/paused}}
                                    {{^paused}}{{#str}}ops:pauserun, local_catquizlab{{/str}}{{/paused}}
                                </a>
                            </td>
                        </tr>
                    {{/inflight.rows}}
                </tbody>
            </table>
        {{/inflight.hasany}}
        {{^inflight.hasany}}
            <p class="text-muted mb-0">{{#str}}ops:nothinginflight, local_catquizlab{{/str}}</p>
        {{/inflight.hasany}}
    </div>
</div>
