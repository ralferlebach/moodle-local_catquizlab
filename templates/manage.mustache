{{!
    @template local_catquizlab/manage

    The landing page of the experiment suite.

    An overview panel on the right, the primary actions above the tables, then
    the experiments and the runs. The previous version put everything into
    collapsed <details> sections, which left a first-time visitor looking at
    three closed triangles and no way in.

    Classes required for JS: none.
    Data attributes required for JS:
    * data-region="catquizlab-situation" — the verdict banner
    * data-region="catquizlab-liveworkers|queued|running|collected|failed" —
      counters the livestatus module keeps current while workers run.
    Data attributes required for JS: none.

    Context variables required for this template:
    * intro string - introductory paragraph
    * container object - has configured bool, coursename, courseurl, settingsurl
    * canedit bool - whether the viewer may create and change experiments
    * newurl string - the experiment editor
    * importurl string - the JSON import page
    * runsurl string - the run overview
    * resultsurl string - the results page
    * presetsurl string - the reusable building blocks
    * overview array of { count int, label string, url string, class string }
    * environment object - has items array of { text string, class string }
    * disabled bool - true when the master switch is off
    * experiments object - hasany, none, nomatch, library (q, hassearch, sorts, actionurl, reseturl, total, shown),
      rows of id, name, editurl, state, statebadge, phase, progress, hasprogress, percent, tierlabel,
      modellabel, strategylabel, cells, runs, modified, main (label, url), more (label, url, link|post, id, action,
      sesskey), candelete, deleteurl (#129)
    * runs object - has hasany bool, hassummary bool, summary string, rows array

    Example context (json):
    {
        "intro": "Prepare, run and evaluate DPF-based adaptive tests.",
        "container": { "configured": false, "settingsurl": "#" },
        "canedit": true,
        "newurl": "/local/catquizlab/experiment.php",
        "importurl": "/local/catquizlab/import.php",
        "runsurl": "/local/catquizlab/runs.php",
        "presetsurl": "/local/catquizlab/presets.php",
        "resultsurl": "/local/catquizlab/results.php",
        "situation": {"state": "idle", "headline": "Nothing is queued and nothing is wrong.", "detail": "", "ok": true, "warn": false, "problem": false, "action": null},
        "settingsurl": "/local/catquizlab/index.php?tab=settings",
        "overview": [
            { "count": 5, "label": "Experiments", "url": "#", "class": "text-primary" }
        ],
        "environment": {
            "items": [ { "text": "CAT engine detected", "class": "text-success" } ]
        },
        "disabled": false,
        "experiments": { "hasany": true, "none": false, "nomatch": false,
            "library": {"q": "", "hassearch": false, "sorts": [{"key": "modified", "label": "Last change", "selected": true}],
                "actionurl": "/local/catquizlab/index.php", "reseturl": "/local/catquizlab/index.php?tab=experiments",
                "total": 1, "shown": 1},
            "rows": [{"id": 1, "name": "Pilot", "editurl": "#", "state": "Collecting sittings", "statebadge": "badge-info",
                "phase": "collecting", "progress": "28 of 40 sittings (70 %)", "hasprogress": true, "percent": 70,
                "tierlabel": "Smoke", "modellabel": "2PL", "strategylabel": "CAT", "cells": 2, "runs": 2,
                "modified": "13/10/26", "main": {"label": "View progress", "url": "#"},
                "more": [{"label": "Compare", "url": "#", "link": true}], "candelete": true, "deleteurl": "#"}
            ]
        },
        "runs": { "hasany": false, "hassummary": false, "summary": "", "rows": [] }
    }
}}
<div class="local-catquizlab-manage">
    <div class="row mx-0">
        <div class="col-lg-8">
            <p class="text-muted">{{intro}}</p>

            {{#canedit}}
                {{!
                    One action, and it is the one this step is for: define
                    something to run. "All runs" and "Results" were links into
                    steps 3 and 4, which the tabs above already reach — a row of
                    buttons leading out of a step is not process guidance, it is
                    a second navigation disagreeing with the first.

                    Presets and import are ways of *starting* a definition, so
                    they stay, as secondary offers rather than peers of the
                    primary one.
                }}
                {{!
                    No "new experiment" button here: it lives beside the
                    experiment selector now, where the list of experiments is.
                    Two places to start one is two places to check when somebody
                    cannot find it.
                }}
                <div class="mb-4">
                    <span class="small">
                        <a href="{{presetsurl}}">{{#str}}manage:presets, local_catquizlab{{/str}}</a>
                        &middot;
                        <a href="{{importurl}}">{{#str}}manage:importexperiment, local_catquizlab{{/str}}</a>
                    </span>
                </div>
            {{/canedit}}
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 card-title">{{#str}}manage:overview, local_catquizlab{{/str}}</h2>
                    <ul class="list-unstyled mb-0">
                        {{#overview}}
                            <li class="d-flex align-items-center justify-content-between py-1">
                                <span>
                                    <strong class="{{class}} mr-2">{{count}}</strong>
                                    <a href="{{url}}">{{label}}</a>
                                </span>
                            </li>
                        {{/overview}}
                    </ul>
                </div>
            </div>
        </div>
    </div>


    {{#disabled}}
        <div class="alert alert-warning">{{#str}}manage:disabled, local_catquizlab{{/str}}</div>
    {{/disabled}}


    {{!
    The state line moved into the shell, where every page gets it. Rendering
    it here as well put two identical banners on this one page.
}}

{{!
    The setup warning used to sit here. The shell says the same thing on
    every page now, with the same action — two alerts about one problem,
    one above the other, is how a reader learns to skip both.
}}

{{!
    The worker fleet and the attempt queue used to sit here. They belong
    to step 3: this step answers "what shall be run", and a panel about
    what is running now is an answer to a different question.
}}

{{#experiments}}
        <h2 class="h4" id="experiments">{{#str}}manage:experiments, local_catquizlab{{/str}}</h2>
        {{! The library (#129): search and sort, one main action per row, the rest under More, delete apart. }}
        {{^none}}
        {{#library}}
            <form method="get" action="{{actionurl}}" class="form-inline mb-2" role="search" data-region="catquizlab-library-search">
                <input type="hidden" name="tab" value="experiments">
                <label for="catquizlab-library-q" class="mr-2">{{#str}}manage:search, local_catquizlab{{/str}}</label>
                <input type="search" name="q" id="catquizlab-library-q" value="{{q}}" class="form-control form-control-sm mr-2">
                <label for="catquizlab-library-sort" class="mr-2">{{#str}}manage:sort, local_catquizlab{{/str}}</label>
                <select name="sort" id="catquizlab-library-sort" class="custom-select custom-select-sm mr-2">
                    {{#sorts}}<option value="{{key}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/sorts}}
                </select>
                <button type="submit" class="btn btn-sm btn-secondary">{{#str}}manage:apply, local_catquizlab{{/str}}</button>
                {{#hassearch}}<a href="{{reseturl}}" class="btn btn-sm btn-link">{{#str}}filter:reset, local_catquizlab{{/str}}</a>{{/hassearch}}
                <span class="small text-muted ml-2" data-region="catquizlab-library-count">{{#str}}manage:shownof, local_catquizlab, { "shown": {{shown}}, "total": {{total}} }{{/str}}</span>
            </form>
        {{/library}}
        {{/none}}
        {{#hasany}}
            <div class="table-responsive position-relative">
            <table class="generaltable table-sm" data-region="catquizlab-library">
                <caption class="sr-only">{{#str}}manage:experiments, local_catquizlab{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}manage:col_name, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_status, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_design, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_modified, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_actions, local_catquizlab{{/str}}</th>
                        <th scope="col"><span class="sr-only">{{#str}}manage:col_delete, local_catquizlab{{/str}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr data-experiment="{{id}}" data-phase="{{phase}}">
                            <th scope="row"><a href="{{editurl}}">{{name}}</a></th>
                            <td>
                                <span class="badge {{statebadge}}">{{state}}</span>
                                {{#hasprogress}}
                                    <div class="small text-muted">{{progress}}</div>
                                {{/hasprogress}}
                            </td>
                            <td class="small">
                                {{strategylabel}} · {{modellabel}} · {{tierlabel}}
                                <div class="text-muted">{{#str}}manage:scope, local_catquizlab, { "cells": "{{cells}}", "runs": {{runs}} }{{/str}}</div>
                            </td>
                            <td class="small">{{modified}}</td>
                            <td class="text-nowrap">
                                <a href="{{main.url}}" class="btn btn-sm btn-primary" data-region="catquizlab-library-main">{{main.label}}</a>
                                <details class="d-inline-block align-top ml-1" data-region="catquizlab-library-more">
                                    <summary class="btn btn-sm btn-outline-secondary">{{#str}}manage:more, local_catquizlab{{/str}}</summary>
                                    <ul class="list-unstyled border rounded bg-white p-1 mt-1 mb-0">
                                        {{#more}}
                                            <li>
                                                {{#link}}<a href="{{url}}" class="btn btn-sm btn-link">{{label}}</a>{{/link}}
                                                {{#post}}
                                                    <form method="post" action="{{url}}" class="d-inline">
                                                        <input type="hidden" name="id" value="{{id}}">
                                                        <input type="hidden" name="action" value="{{action}}">
                                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                                        <button type="submit" class="btn btn-sm btn-link">{{label}}</button>
                                                    </form>
                                                {{/post}}
                                            </li>
                                        {{/more}}
                                    </ul>
                                </details>
                            </td>
                            <td class="text-right">
                                {{#candelete}}
                                    <a href="{{deleteurl}}" class="btn btn-sm btn-outline-danger" data-region="catquizlab-library-delete"
                                       aria-label="{{#str}}manage:deletenamed, local_catquizlab, {{name}}{{/str}}">
                                        {{#str}}manage:delete, local_catquizlab{{/str}}
                                    </a>
                                {{/candelete}}
                            </td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
            </div>
        {{/hasany}}
        {{#none}}
            <div class="alert alert-info" data-region="catquizlab-library-empty">{{#str}}manage:noexperiments, local_catquizlab{{/str}}
                {{#canedit}}<a href="{{newurl}}" class="btn btn-sm btn-primary ml-2">{{#str}}shell:newexperiment, local_catquizlab{{/str}}</a>{{/canedit}}
            </div>
        {{/none}}
        {{#nomatch}}
            <div class="alert alert-secondary" data-region="catquizlab-library-nomatch">{{#str}}manage:nomatch, local_catquizlab, {{library.q}}{{/str}}
                <a href="{{library.reseturl}}">{{#str}}filter:reset, local_catquizlab{{/str}}</a>
            </div>
        {{/nomatch}}
    {{/experiments}}

</div>
