{{!
    @template local_catquizlab/manage

    The landing page of the experiment suite.

    An overview panel on the right, the primary actions above the tables, then
    the experiments and the runs. The previous version put everything into
    collapsed <details> sections, which left a first-time visitor looking at
    three closed triangles and no way in.

    Classes required for JS: none.
    Data attributes required for JS:
    * data-region="catquizlab-situation" — the verdict banner
    * data-region="catquizlab-liveworkers|queued|running|collected|failed" —
      counters the livestatus module keeps current while workers run.
    Data attributes required for JS: none.

    Context variables required for this template:
    * intro string - introductory paragraph
    * container object - has configured bool, coursename, courseurl, settingsurl
    * canedit bool - whether the viewer may create and change experiments
    * newurl string - the experiment editor
    * importurl string - the JSON import page
    * runsurl string - the run overview
    * resultsurl string - the results page
    * presetsurl string - the reusable building blocks
    * overview array of { count int, label string, url string, class string }
    * environment object - has items array of { text string, class string }
    * disabled bool - true when the master switch is off
    * experiments object - has hasany bool and rows array
    * runs object - has hasany bool, hassummary bool, summary string, rows array

    Example context (json):
    {
        "intro": "Prepare, run and evaluate DPF-based adaptive tests.",
        "container": { "configured": false, "settingsurl": "#" },
        "canedit": true,
        "newurl": "/local/catquizlab/experiment.php",
        "importurl": "/local/catquizlab/import.php",
        "runsurl": "/local/catquizlab/runs.php",
        "presetsurl": "/local/catquizlab/presets.php",
        "resultsurl": "/local/catquizlab/results.php",
        "situation": {"state": "idle", "headline": "Nothing is queued and nothing is wrong.", "detail": "", "ok": true, "warn": false, "problem": false, "action": null},
        "settingsurl": "/local/catquizlab/index.php?tab=settings",
        "overview": [
            { "count": 5, "label": "Experiments", "url": "#", "class": "text-primary" }
        ],
        "environment": {
            "items": [ { "text": "CAT engine detected", "class": "text-success" } ]
        },
        "disabled": false,
        "experiments": { "hasany": false, "rows": [] },
        "runs": { "hasany": false, "hassummary": false, "summary": "", "rows": [] }
    }
}}
<div class="local-catquizlab-manage">
    <div class="row">
        <div class="col-lg-8">
            <p class="text-muted">{{intro}}</p>

            {{#canedit}}
                <div class="mb-4">
                    <a href="{{newurl}}" class="btn btn-primary">
                        {{#str}}manage:newexperiment, local_catquizlab{{/str}}
                    </a>
                    <a href="{{importurl}}" class="btn btn-outline-secondary ml-2">
                        {{#str}}manage:importexperiment, local_catquizlab{{/str}}
                    </a>
                    <a href="{{presetsurl}}" class="btn btn-outline-secondary ml-2">
                        {{#str}}manage:presets, local_catquizlab{{/str}}
                    </a>
                    <a href="{{runsurl}}" class="btn btn-outline-secondary ml-2">
                        {{#str}}manage:allruns, local_catquizlab{{/str}}
                    </a>
                    <a href="{{resultsurl}}" class="btn btn-outline-secondary ml-2">
                        {{#str}}heading:results, local_catquizlab{{/str}}
                    </a>
                </div>
            {{/canedit}}
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 card-title">{{#str}}manage:overview, local_catquizlab{{/str}}</h2>
                    <ul class="list-unstyled mb-0">
                        {{#overview}}
                            <li class="d-flex align-items-center justify-content-between py-1">
                                <span>
                                    <strong class="{{class}} mr-2">{{count}}</strong>
                                    <a href="{{url}}">{{label}}</a>
                                </span>
                            </li>
                        {{/overview}}
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {{#container}}
        {{#configured}}
            <div class="mb-3">
                <span class="text-muted">{{#str}}container:label, local_catquizlab{{/str}}</span>
                <a href="{{courseurl}}">{{coursename}}</a>
                <a href="{{settingsurl}}" class="ml-2">{{#str}}container:change, local_catquizlab{{/str}}</a>
            </div>
        {{/configured}}
        {{^configured}}
            <div class="alert alert-warning">
                <p class="mb-2">{{#str}}container:nocourse, local_catquizlab{{/str}}</p>
                <a href="{{settingsurl}}" class="btn btn-secondary">
                    {{#str}}container:choose, local_catquizlab{{/str}}
                </a>
            </div>
        {{/configured}}
    {{/container}}

    {{#disabled}}
        <div class="alert alert-warning">{{#str}}manage:disabled, local_catquizlab{{/str}}</div>
    {{/disabled}}

    {{#environment}}
        <details class="local-catquizlab-section mb-4">
            <summary class="local-catquizlab-summary">
                <span class="h5">{{#str}}manage:environment, local_catquizlab{{/str}}</span>
            </summary>
            <div class="mt-2">
                {{#items}}
                    <div class="{{class}}">{{text}}</div>
                {{/items}}
            </div>
        </details>
    {{/environment}}

    {{#situation}}
    <div class="alert {{#ok}}alert-info{{/ok}}{{#warn}}alert-warning{{/warn}}{{#problem}}alert-danger{{/problem}} d-flex align-items-center justify-content-between"
         role="status" data-region="catquizlab-situation">
        <div>
            <strong>{{headline}}</strong>
            {{#detail}}<div class="small">{{.}}</div>{{/detail}}
        </div>
        {{#action}}
            <a href="{{url}}" class="btn btn-primary ml-3">{{label}}</a>
        {{/action}}
    </div>
{{/situation}}

{{#setupnotice}}
    <div class="alert alert-warning" role="status">
        <strong>{{#str}}setup:notready, local_catquizlab{{/str}}</strong>
        <p class="mb-2">{{blockers}}</p>
        <a href="{{opsurl}}" class="btn btn-primary">{{#str}}setup:open, local_catquizlab{{/str}}</a>
    </div>
{{/setupnotice}}

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{#str}}worker:heading, local_catquizlab{{/str}}</h3>
        {{#workers}}
            <p class="mb-1">
                {{#str}}worker:fleet, local_catquizlab{{/str}}
                <span class="badge {{#hasslot}}badge-success{{/hasslot}}{{^hasslot}}badge-secondary{{/hasslot}}"
                      data-region="catquizlab-liveworkers">{{live}}</span>
                {{#crashed}}<span class="badge badge-warning ml-1">{{#str}}worker:crashed, local_catquizlab{{/str}} {{crashed}}</span>{{/crashed}}
            </p>
            <p class="mb-1 text-muted small">
                {{#str}}worker:queue, local_catquizlab{{/str}}
                <span data-region="catquizlab-queued">{{queue.queued}}</span> /
                <span data-region="catquizlab-running">{{queue.running}}</span> /
                <span data-region="catquizlab-collected">{{queue.collected}}</span> /
                <span data-region="catquizlab-failed">{{queue.failed}}</span>
            </p>
            {{#queue.stalled}}
                <div class="alert alert-warning mb-0" role="status">
                    {{#str}}worker:stalled, local_catquizlab{{/str}}
                </div>
            {{/queue.stalled}}
            {{#lasterror}}<p class="mb-0 small text-muted">{{lasterror}}</p>{{/lasterror}}
        {{/workers}}
        {{#recenterrors}}
            <h4 class="h6 mt-3">{{#str}}worker:recenterrors, local_catquizlab{{/str}}</h4>
            <ul class="small mb-0">
                {{#rows}}<li>#{{attemptid}} ({{#str}}worker:tries, local_catquizlab{{/str}} {{tries}}): {{lasterror}}</li>{{/rows}}
            </ul>
        {{/recenterrors}}
    </div>
</div>

{{#experiments}}
        <h2 class="h4">{{#str}}manage:experiments, local_catquizlab{{/str}}</h2>
        {{#hasany}}
            <table class="generaltable table-sm">
                <caption class="sr-only">{{#str}}manage:experiments, local_catquizlab{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}manage:col_name, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_tier, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_model, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_strategy, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_status, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_cells, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_runs, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_modified, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_actions, local_catquizlab{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <td><a href="{{editurl}}">{{name}}</a></td>
                            <td>{{tierlabel}}</td>
                            <td>{{modellabel}}</td>
                            <td>{{strategylabel}} <span class="text-muted small">({{strategy}})</span></td>
                            <td><span class="badge {{statusclass}}">{{status}}</span></td>
                            <td>{{cells}}</td>
                            <td>{{runs}}</td>
                            <td>{{modified}}</td>
                            <td>{{{actions}}}</td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        {{/hasany}}
        {{^hasany}}
            <div class="alert alert-info">{{#str}}manage:noexperiments, local_catquizlab{{/str}}</div>
        {{/hasany}}
    {{/experiments}}

    {{#runs}}
        <h2 class="h4 mt-4">{{#str}}manage:runs, local_catquizlab{{/str}}</h2>
        {{#hassummary}}
            <div class="text-muted mb-2">{{summary}}</div>
        {{/hassummary}}
        {{#hasany}}
            <table class="generaltable table-sm">
                <caption class="sr-only">{{#str}}manage:runs, local_catquizlab{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}run:id, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}manage:col_experiment, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}form:strategy, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}form:variant, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}form:stratum, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}run:status, local_catquizlab{{/str}}</th>
                        <th scope="col">{{#str}}run:progress, local_catquizlab{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <td><a href="{{detailurl}}">{{id}}</a></td>
                            <td>{{experiment}}</td>
                            <td>{{strategylabel}}</td>
                            <td>{{variantlabel}}</td>
                            <td>{{stratumlabel}}</td>
                            <td><span class="badge {{statusclass}}">{{statuslabel}}</span></td>
                            <td>
                                <div class="progress" style="height:0.75rem;">
                                    <div class="progress-bar {{progressclass}}" role="progressbar"
                                         style="width:{{progress}}%;"
                                         aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100"
                                         aria-label="{{progresslabel}}"></div>
                                </div>
                                <span class="small text-muted">{{progress}}&nbsp;%</span>
                            </td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
            <a href="{{runsurl}}">{{#str}}manage:allruns, local_catquizlab{{/str}}</a>
        {{/hasany}}
        {{^hasany}}
            <div class="alert alert-info">{{#str}}manage:noruns, local_catquizlab{{/str}}</div>
        {{/hasany}}
    {{/runs}}
</div>
