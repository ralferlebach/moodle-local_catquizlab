{{!
    @template local_catquizlab/shell

    The frame every CatQuizLab page renders inside: the four process steps, the
    experiment in context, and one line about the state of the installation.

    Rendered on every page rather than only the landing one, because opening a
    run used to drop the reader out of the process they were in the middle of.

    Classes required for JS: none.
    Data attributes required for JS:
    * data-region="catquizlab-situation" - the installation's state line.
    * data-region="catquizlab-status" (data-phase, data-next) and its
      catquizlab-status-* regions - the experiment's status bar (#128), kept
      current by the livestatus module.

    Context variables required for this template:
    * title - the plugin name
    * steps - key, number, label, url, current
    * experiments - id, name, selected
    * hasexperiments - whether there are any
    * experimentid - the one in context, or 0
    * selecturl - where the selector posts
    * newurl - where a new experiment is started
    * situation - headline, detail, ok/warn/problem and action for the installation (no experiment chosen)
    * status - the experiment's status (experiment_status::snapshot): name, phase, label, badge,
      sittings, problemtext, hasproblems, reason, computedtext, technical, next, shownext
    * settingsurl - where settings live

    Example context (json):
    {
        "title": "CAT experiment suite",
        "steps": [
            {"key": "prepare", "number": 1, "label": "Preparation", "url": "/local/catquizlab/index.php?tab=setup", "current": true},
            {"key": "plan", "number": 2, "label": "Experiment plan", "url": "/local/catquizlab/index.php?tab=experiments", "current": false}
        ],
        "experiments": [{"id": 1, "name": "Smoke Test 2", "selected": true}],
        "hasexperiments": true,
        "newurl": "/local/catquizlab/experiment.php",
        "experimentid": 1,
        "selecturl": "/local/catquizlab/index.php",
        "situation": null,
        "status": {"name": "Smoke Test 2", "phase": "collecting", "label": "Collecting sittings", "badge": "info",
            "sittings": "28 of 40 sittings (70 %)", "problemtext": "No problems", "hasproblems": false, "reason": "",
            "computedtext": "As of 13:20", "technical": "Workers: 2 live, 2 sittings in progress, 10 waiting",
            "shownext": false, "next": {"kind": "progress", "label": "View progress", "url": "/local/catquizlab/runs.php", "post": false}
        },
        "settingsurl": "/local/catquizlab/index.php?tab=settings"
    }
}}
<div class="catquizlab-shell mb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap">
        <h2 class="h4 mb-2">{{title}}</h2>
        <a href="{{settingsurl}}" class="small">{{#str}}tab:settings, local_catquizlab{{/str}}</a>
    </div>

    <ul class="nav nav-tabs mb-2" data-region="catquizlab-steps">
        {{#steps}}
            <li class="nav-item">
                <a class="nav-link {{#current}}active{{/current}}" href="{{url}}">
                    {{number}}. {{label}}
                </a>
            </li>
        {{/steps}}
    </ul>

{{!
    Below the tabs on purpose. The selector scopes what the current step shows,
    so it belongs under the step rather than above the navigation — put over the
    tabs it read as a filter on the whole plugin, which it is not.
}}
    {{#hasexperiments}}
        <form method="get" action="{{selecturl}}" class="form-inline mb-2">
            <label for="catquizlab-experiment" class="mr-2">
                {{#str}}shell:experiment, local_catquizlab{{/str}}
            </label>
            <select name="experimentid" id="catquizlab-experiment" class="custom-select mr-2"
                    onchange="this.form.submit()">
                <option value="0">{{#str}}shell:allexperiments, local_catquizlab{{/str}}</option>
                {{#experiments}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/experiments}}
            </select>
            <noscript><button type="submit" class="btn btn-sm btn-secondary">
                {{#str}}shell:apply, local_catquizlab{{/str}}
            </button></noscript>
        </form>

        {{!
            Beside the selector, because creating one is the other thing a
            person does with the list of experiments — and looking for it on a
            different tab is how somebody ends up making their second
            experiment by editing their first.
        }}
    {{/hasexperiments}}

    {{!
        Outside the selector block on purpose: an installation with no
        experiments still needs a way to make one, and putting this behind
        "there is at least one experiment" is a dead end on the step whose
        whole job is to start them.
    }}
    {{#newurl}}
        <a href="{{.}}" class="btn btn-sm btn-primary mb-2" data-region="catquizlab-new-experiment">{{#str}}shell:newexperiment, local_catquizlab{{/str}}</a>
    {{/newurl}}

    {{! The installation, where no experiment is chosen. The template read
        fields the verdict never had (state, reason, good/watch/bad): the bar
        showed the internal word "working" or "failing" and nothing else (#128). }}
    {{#situation}}
        <div class="alert {{#ok}}alert-info{{/ok}}{{#warn}}alert-warning{{/warn}}{{#problem}}alert-danger{{/problem}} py-2 mb-2"
             role="status" data-region="catquizlab-situation">
            <div class="d-flex align-items-center justify-content-between flex-wrap">
                <div>
                    <strong data-region="catquizlab-situation-state">{{headline}}</strong>
                    <span class="small" data-region="catquizlab-situation-reason">{{detail}}</span>
                </div>
                {{#action}}<a href="{{url}}" class="btn btn-sm btn-primary ml-2">{{label}}</a>{{/action}}
            </div>
        </div>
    {{/situation}}

    {{! The experiment in view (#128): name, phase, sittings, problems, the one next step. }}
    {{#status}}
        <section class="card mb-2 border-{{badge}}" data-region="catquizlab-status" data-phase="{{phase}}"
                 data-next="{{next.kind}}" aria-labelledby="catquizlab-status-name">
            <div class="card-body py-2 d-flex flex-wrap align-items-center justify-content-between">
                <div class="mr-2">
                    <h3 class="h6 d-inline mb-0" id="catquizlab-status-name">{{name}}</h3>
                    <span class="badge badge-{{badge}} ml-1" data-region="catquizlab-status-label" role="status">{{label}}</span>
                    <span class="ml-2" data-region="catquizlab-status-sittings">{{sittings}}</span>
                    <span class="ml-2 {{#hasproblems}}text-danger{{/hasproblems}}{{^hasproblems}}text-muted{{/hasproblems}}"
                          data-region="catquizlab-status-problems">{{problemtext}}</span>
                    <div class="small text-muted">
                        <span data-region="catquizlab-status-reason">{{reason}}</span>
                        <span data-region="catquizlab-status-asof">{{computedtext}}</span>
                        <span class="ml-2" data-region="catquizlab-status-technical">{{technical}}</span>
                    </div>
                </div>
                {{#shownext}}
                    {{#next.post}}
                        <form method="post" action="{{next.url}}" class="d-inline" data-region="catquizlab-status-next">
                            <input type="hidden" name="sesskey" value="{{next.sesskey}}">
                            <input type="hidden" name="action" value="{{next.action}}">
                            <input type="hidden" name="experimentid" value="{{next.experimentid}}">
                            <button type="submit" class="btn btn-sm btn-primary">{{next.label}}</button>
                        </form>
                    {{/next.post}}
                    {{^next.post}}
                        <a href="{{next.url}}" class="btn btn-sm btn-primary" data-region="catquizlab-status-next">{{next.label}}</a>
                    {{/next.post}}
                {{/shownext}}
            </div>
        </section>
    {{/status}}


</div>
